{
  "cli": {
    "version": ">= 16.17.4"
  },
  "build": {
    "production": {
      "android": {
        "distribution": "store",
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    },
    "development": {
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
