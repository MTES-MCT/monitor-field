{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "android": {
        "distribution": "store",
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "environment": "production"
    },
    "development": {
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "autoIncrement": true
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    }
  }
}
