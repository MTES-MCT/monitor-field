{
  "name": "monitorfield",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:type": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build:android:production": "eas build --platform android --profile production",
    "build:android:production:ci": "eas build --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@expo/ui": "56.0.18",
    "@gorhom/bottom-sheet": "5.2.14",
    "@maplibre/maplibre-react-native": "11.3.4",
    "@op-engineering/op-sqlite": "16.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "dayjs": "1.11.21",
    "expo": "56.0.12",
    "expo-constants": "56.0.18",
    "expo-dev-client": "56.0.20",
    "expo-device": "56.0.4",
    "expo-font": "56.0.7",
    "expo-glass-effect": "56.0.4",
    "expo-image": "56.0.11",
    "expo-linking": "56.0.14",
    "expo-location": "56.0.18",
    "expo-router": "56.2.11",
    "expo-splash-screen": "56.0.10",
    "expo-status-bar": "56.0.4",
    "expo-symbols": "56.0.6",
    "expo-system-ui": "56.0.5",
    "expo-web-browser": "56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "eslint-plugin-expo": "1.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "lint-staged": "17.0.8",
    "oxlint": "1.73.0",
    "prettier": "3.8.4",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "oxlint --fix",
      "bash -c 'npm run test:type'"
    ]
  },
  "op-sqlite": {
    "performanceMode": true
  }
}